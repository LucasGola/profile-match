# Copie para .env e ajuste conforme necessário: cp .env.example .env
# O .env NAO deve ser commitado (ja esta no .gitignore).

# --- Postgres (lido pelo docker-compose e pelo Prisma) ---
POSTGRES_USER=profilematch
POSTGRES_PASSWORD=profilematch
POSTGRES_DB=profilematch
POSTGRES_PORT=5432

# URL de conexao do Prisma. Aponta para o Postgres do docker-compose (localhost).
DATABASE_URL="postgresql://profilematch:profilematch@localhost:5432/profilematch?schema=public"

# --- Redis (fila BullMQ + cache) ---
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"
