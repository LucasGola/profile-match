# Copie para .env e ajuste conforme necessário: cp .env.example .env
# O .env NAO deve ser commitado (ja esta no .gitignore).

# --- Aplicacao ---
NODE_ENV=development
# Nivel de log: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Postgres (lido pelo docker-compose e pelo Prisma) ---
POSTGRES_USER=profilematch
POSTGRES_PASSWORD=profilematch
POSTGRES_DB=profilematch
POSTGRES_PORT=5432

# URL de conexao do Prisma. Aponta para o Postgres do docker-compose (localhost).
DATABASE_URL="postgresql://profilematch:profilematch@localhost:5432/profilematch?schema=public"

# --- Redis (fila BullMQ + cache) ---
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# --- API ---
# Porta da API REST.
API_PORT=3000
# TTL do cache das listagens, em segundos.
CACHE_TTL_SECONDS=60

# --- Coleta ---
# Intervalo entre coletas automáticas, em milissegundos (padrão: 30 min).
COLLECT_INTERVAL_MS=1800000
# Concorrência do worker (jobs de coleta em paralelo).
WORKER_CONCURRENCY=3

# --- Notificação ---
# Score mínimo para notificar (padrão: 80).
NOTIFY_MIN_SCORE=80
# Telegram: se ambos vazios, as notificações vão apenas para o log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
